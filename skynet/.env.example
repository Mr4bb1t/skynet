# =============================================================================
# SKYNET - VISAO PARA GEMINI LIVE (EXEMPLO)
# Copie para .env e preencha. NUNCA versione o .env com chaves reais.
# =============================================================================

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_TEXT_FALLBACK_MODEL=gemini-3.6-flash
CAMERA_URL=rtsp://usuario:senha@192.168.10.14:554/onvif2

CAPTURE_FPS=10
# Pula o ffprobe inicial quando a resolução já é conhecida.
# CAMERA_SKIP_PROBE=false

# Memoria de pessoas (face recognition local, sem nuvem)
PERSON_MEMORY_ENABLED=true
PERSON_DB_PATH=data/people.db
PERSON_PHOTO_DIR=data/people
FACE_MATCH_THRESHOLD=0.6

# Memoria de longo prazo (RAG: SQLite + FTS5 + embeddings)
MEMORY_ENABLED=true
MEMORY_DB_PATH=data/memory.db
# Embeddings semanticos via Gemini; se falhar, cai para busca lexical local.
MEMORY_EMBEDDINGS_ENABLED=true
MEMORY_EMBEDDING_MODEL=gemini-embedding-001
MEMORY_EMBEDDING_DIM=768
# Economia de tokens: no maximo 5 memorias e ~380 tokens por contexto.
MEMORY_RAG_TOP_K=5
MEMORY_RAG_TOKEN_BUDGET=380
MEMORY_PHOTO_TOKEN_BUDGET=160
MEMORY_RAG_MIN_SCORE=0.20
MEMORY_RECENCY_HALF_LIFE_DAYS=45
MEMORY_MAX_CONTENT_CHARS=700

# PTZ/ONVIF: intervalo entre pulsos. Esta camera aceita ~1 passo/s.
PTZ_INTERVAL_SEC=0.8
# Se a senha ONVIF for diferente da senha do RTSP, defina:
# CAMERA_ONVIF_USER=admin
# CAMERA_ONVIF_PASS=

# Heartbeat visual automatico (1 imagem/s). Use false para desativar os envios.
IMAGE_HEARTBEAT_ENABLED=true
IMAGE_SEND_FPS=1

# Preset local: LOW=320 | BALANCED=640 | DETAIL=960
IMAGE_PRESET=BALANCED
IMAGE_MAX_WIDTH=640
IMAGE_MAX_HEIGHT=480
JPEG_QUALITY=75

# LOW | MEDIUM | HIGH | UNSPECIFIED
MEDIA_RESOLUTION=LOW

# -----------------------------------------------------------------------------
# AUDIO BIDIRECIONAL / CONVERSA (GEMINI LIVE)
# -----------------------------------------------------------------------------
# Fonte do Microfone: "camera" (RTSP onvif1) ou "local" (USB / P2 no TV Box)
AUDIO_INPUT_BACKEND=local
# Microfone da camera (experimental): abre uma 2a sessao RTSP e pode travar a
# camera. Se precisar, use uma stream diferente do video (ex: /onvif2).
# CAMERA_AUDIO_PATH=/onvif2
# Dispositivo ALSA do microfone local (veja `arecord -l`; ex: plughw:Device,0)
AUDIO_LOCAL_DEVICE=plughw:Device,0
# Saida de audio: fone / caixinha (veja `aplay -l`; ex: plughw:Device,0 | AV Box: hw:0,0)
AUDIO_OUTPUT_DEVICE=plughw:Device,0
AUDIO_MIC_GAIN=1.0
GEMINI_LIVE_MODEL=gemini-3.8-live

# -----------------------------------------------------------------------------
# CANCELAMENTO DE ECO ACUSTICO (AEC3 / WebRTC)
# -----------------------------------------------------------------------------
# Remove a propria voz do Skynet da captura do microfone, permitindo barge-in.
# Se a lib nativa nao estiver instalada, o audio segue sem cancelamento.
AEC_ENABLED=true
# Dica de atraso alto-falante -> microfone (o aplay usa buffer de 150 ms).
AEC_DELAY_MS=150
# Limite do buffer de referencia far-end, em milissegundos.
AEC_FAR_MAX_MS=1000

# Half-duplex de seguranca enquanto o AEC3 nao esta ativo: silencia o microfone
# durante a fala do robo para ele nao se autointerromper. "auto" desliga sozinho
# quando o AEC3 estiver ativo (volta o barge-in). Use 0 para forcar full-duplex.
AUDIO_HALF_DUPLEX=auto
# Tempo extra de silencio apos o fim da fala (ms).
AUDIO_HALF_DUPLEX_HOLD_MS=400
# Transcrição da fala do usuário (usada para o RAG contextual no modo voz).
# GEMINI_INPUT_TRANSCRIPTION=true

LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Opcionais (valores padrao mostrados)
# -----------------------------------------------------------------------------
# CAMERA_RTSP_TRANSPORT=udp
# CAMERA_PROBE_TIMEOUT_SEC=10
# CAMERA_READ_TIMEOUT_SEC=5
# CAMERA_RECONNECT_BASE_SEC=1
# CAMERA_RECONNECT_MAX_SEC=30
# CAPTURE_MAX_WIDTH=0
# FRAME_STALE_SEC=3
# GEMINI_RESPONSE_MODALITY=AUDIO
# GEMINI_OUTPUT_TRANSCRIPTION=true
# GEMINI_SESSION_RESUMPTION=true
# GEMINI_CONTEXT_COMPRESSION=true
# CONTEXT_TRIGGER_TOKENS=
# GEMINI_SEND_TIMEOUT_SEC=5
# GEMINI_RECONNECT_BASE_SEC=1
# GEMINI_RECONNECT_MAX_SEC=30
# DIAGNOSTICS_INTERVAL_SEC=30
# LOG_EACH_FRAME=false
# VISION_STORAGE_DIR=/tmp/skynet/vision
